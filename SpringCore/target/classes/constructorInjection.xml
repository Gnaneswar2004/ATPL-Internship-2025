<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.springframework.org/schema/beans
                               http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<bean id="course" class="com.aaslin.SpringCore.ConstructorInjection.Course">
		<constructor-arg value="Spring framework"/>
	</bean>
	
    <bean id="faculty" class="com.aaslin.SpringCore.ConstructorInjection.Faculty">
    	<constructor-arg ref="course"/>
    </bean>

</beans>